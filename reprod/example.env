############################################################
# Ratings integration
# Multiple directories can be separated by colon (:) or comma (,)
############################################################
# Please Note: If you make use of the datasets provided on the GIGA FTP server, you can simply put the directories from there in the reprod/llm_outputs directory
# If you make use of the datasets provided there (the outputs of the LLM from our research run) you are expected to get the same results as we reported


RATINGS_DIRS=reprod/llm_outputs/ontological_prompt_rating_outputs/replicationsoutputs_2,reprod/llm_outputs/ontological_prompt_rating_outputs/replicationoutputs_3,reprod/llm_outputs/ontological_prompt_rating_outputs/replicationoutputs4,reprod/llm_outputs/ontological_prompt_rating_outputs/replicationoutputs__iteration_5,reprod/llm_outputs/ontological_prompt_rating_outputs/replicationoutputs__iteration_6,reprod/llm_outputs/ontological_prompt_rating_outputs/replicationoutputs__iteration_7,reprod/llm_outputs/ontological_prompt_rating_outputs/replicationoutputs__iteration_8,reprod/llm_outputs/ontological_prompt_rating_outputs/replicationoutputs__iteration_9,reprod/llm_outputs/ontological_prompt_rating_outputs/replicationoutputs__iteration_10,reprod/llm_outputs/ontological_prompt_rating_outputs/replicationoutputs_iteration_11
ZERO_SHOT_RATINGS_DIRS=/app/llm_outputs/zeroshot_outputs/zero_shot_outputs_iteration_0:/app/llm_outputs/zeroshot_outputs/zero_shot_outputs_iteration_1:/app/llm_outputs/zeroshot_outputs/zero_shot_outputs_iteration_2:/app/llm_outputs/zeroshot_outputs/zero_shot_outputs_iteration_3:/app/llm_outputs/zeroshot_outputs/zero_shot_outputs_iteration_4:/app/llm_outputs/zeroshot_outputs/zero_shot_outputs_iteration_5:/app/llm_outputs/zeroshot_outputs/zero_shot_outputs_iteration_6:/app/llm_outputs/zeroshot_outputs/zero_shot_outputs_iteration_7:/app/llm_outputs/zeroshot_outputs/zero_shot_outputs_iteration_8:/app/llm_outputs/zeroshot_outputs/zero_shot_outputs_iteration_9

############################################################
# GO classification (LLM output integration)
############################################################
GO_CLASSIFICATION_RESPONSES_DIR=/app/llm_outputs/GO_classification_responses

############################################################
# Input data (inside container, relative to /app/datasets)
############################################################
input_path_arukucl=datasets/ARUK-UCL-GO-terms.tsv
output_path_arukucl=datasets/filtered_ARUK-UCL-GO-terms.tsv

# DrugBank XML
DRUGBANK_XML=datasets/drugbank_full_dataset.xml
# Optional: override the namespace if DrugBank XML differs
# DRUGBANK_NS=http://www.drugbank.ca


############################################################
# Logging
############################################################
# We implemented hierarchical logging in the scripts to allow researcher to follow the logs
# You may want to set the logging level to "warning" if you are mainly interested in checking if the reported results are reproducible
# For deeper understanding of the code the LOG_LEVEL INFO or even DEBUG are recommended
LOG_LEVEL=INFO

############################################################
# Neo4j database credentials
# - NEO4J_AUTH is shared with the Neo4j container
# - uri/username/password used by pipeline scripts
############################################################
NEO4J_AUTH=neo4j/testpassword
uri=bolt://neo4j:7687
username=neo4j
# password can be omitted; entrypoint parses from NEO4J_AUTH if missing


############################################################
# LLM / Embedding models
############################################################
# Default model to pull on init
LLM_MODEL_PULL=llama3:8b

# Optional LLM generation step (defaults to skip)
RUN_LLM=false
LLM_URL=http://ollama:11434/api/generate #if you run ollama as a separate instance on your machine, change this to localhost
LLM_MODEL=llama3:8b

# allow slow CPU inference to finish
# actually, if this becomes relevant to you, the infrastructure you run the code on is not sufficient for running these replication steps
# However, if you need a proof of concept that you can get llm ratings this might be helpful
LLM_HTTP_TIMEOUT=600


# Embeddings endpoint (used for UMAP etc.)
EMBED_URL=http://ollama:11434/api/embed #if you run ollama as a separate instance on your machine, change this to localhost
EMBED_MODEL=llama3:8b

############################################################
# LLM prompt/response paths
############################################################
PROMPTS_DIR=/app/exports/prompts
RESPONSES_DIR=/app/exports/llm_responses
LOG_DIR=/app/logs/llm_runs

# Iteration control for LLM runs
ITERATIONS=1
START_ITERATION=1


############################################################
# Top-100 lists (for UMAP plots and stats)
############################################################
TOP100_DIR=/app/exports/top_100_drugs_for_umap_plot
TOP100_STATIC_CSV=${TOP100_DIR}/ontological_prompt_top_100.csv
TOP100_ZS_CSV=${TOP100_DIR}/zero_shot_top_100.csv

